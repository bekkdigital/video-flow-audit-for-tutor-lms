/.github
/.wordpress-org
/.vscode
/bin
/tests
/dist
/node_modules
/vendor

/.gitignore
/.distignore
/.editorconfig
/build.sh
/composer.json
/composer.lock
/composer.phar
/phpcs.xml.dist
/phpstan.neon.dist
/phpstan-baseline.neon
/.phpunit.result.cache
/CLAUDE.md
/AGENTS.md
/README.md

/lib/video-flow-core/README.md
